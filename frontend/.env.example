# Copy to .env.local. These Firebase Web settings are public configuration, not service-account credentials.
# Use preview for local demonstrations, firebase for real staff sign-in.
VITE_APP_MODE=preview
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side development proxy setting; never exposed as a browser API URL.
BACKEND_PROXY_TARGET=http://localhost:8080

# Required by npm run prepare:hosting. Use the group's actual Cloud Run values.
FIREBASE_RUN_SERVICE_ID=
FIREBASE_RUN_REGION=
